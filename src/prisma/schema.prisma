generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid())
  email                String    @unique
  full_name            String
  profile              String?
  password             String
  email_verified       Boolean   @default(false)
  reset_password_token String?
  reset_token_expires  DateTime?
  refresh_token        String?   @unique
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  roles_id             Int
  role                 Role      @relation(fields: [roles_id], references: [id], onDelete: Restrict)
  rating               Rating[]
  comment              Comment[]
  blog                 Blog[]
  judge                judge?
  student              student?

  @@index([uuid])
  @@map("user")
}

enum RoleType {
  admin
  student
  user
  staff
  judge
}

model Role {
  id   Int      @id @default(autoincrement())
  uuid String   @unique @default(uuid())
  name RoleType @unique @default(user)
  user User[]

  @@index([uuid])
  @@map("role")
}

model Rating {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  content_id   Int
  content      Content  @relation(fields: [content_id], references: [id], onDelete: Cascade)
  rating_by    Int
  user         User     @relation(fields: [rating_by], references: [id], onDelete: Cascade)
  rating_value Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  episode      Episode? @relation(fields: [episode_id], references: [id])
  episode_id   Int?

  @@unique(name: "rating_content", [content_id, rating_by])
  @@unique(name: "rating_episode", [episode_id, rating_by])
  @@index([uuid])
  @@map("rating")
}

model Comment {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  content_id      Int
  content         Content  @relation(fields: [content_id], references: [id], onDelete: Cascade)
  comment_content String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  commented_by    Int
  user            User     @relation(fields: [commented_by], references: [id], onDelete: Cascade)
  episode         Episode? @relation(fields: [episodes_id], references: [id])
  episodes_id     Int?

  @@index([uuid])
  @@map("comment")
}

enum ContentType {
  ebook
  video
  audio
  story
  prakerin
  blog
}

enum ContentStatus {
  pending
  approved
  rejected
}

model Content {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  type          ContentType
  title         String
  thumbnail     String
  description   String?
  slug          String        @unique
  status        ContentStatus @default(pending)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt
  category_id   Int
  category      Category      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  genre         Genre[]
  comment       Comment[]
  rating        Rating[]
  video_podcast VideoPodcast?
  audio_podcast AudioPodcast?
  blog          Blog?
  ebook         Ebook?
  story         Story?
  prakerin      Prakerin?
  submission    Submission?
  tag           Tag[]

  @@index([uuid])
  @@map("content")
}

model FileAttachment {
  id            Int            @id @default(autoincrement())
  uuid          String         @unique @default(uuid())
  file          String
  type          ContentType
  size          Int?
  mimeType      String?
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  audio_podcast AudioPodcast[]
  ebook         Ebook[]
  prakerin      Prakerin[]

  @@index([uuid])
  @@map("file_attachment")
}

model Category {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  avatar      String?
  name        String    @unique
  description String?
  content     Content[]

  @@index([uuid])
  @@map("category")
}

model Tag {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  avatar      String?
  name        String    @unique
  description String?
  content     Content[]

  @@index([uuid])
  @@map("tag")
}

model Genre {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  avatar      String?
  name        String    @unique
  description String?
  content     Content[]

  @@index([uuid])
  @@map("genre")
}

model VideoPodcast {
  id         Int     @id @default(autoincrement())
  uuid       String  @unique @default(uuid())
  link       String
  creator_id Int
  creator    student @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  content_id Int     @unique
  content    Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("video_podcast")
}

model AudioPodcast {
  id              Int            @id @default(autoincrement())
  uuid            String         @unique @default(uuid())
  duration        Float
  file_id         Int
  creator_id      Int
  creator         student        @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  content_id      Int            @unique
  content         Content        @relation(fields: [content_id], references: [id], onDelete: Cascade)
  file_attachment FileAttachment @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("audio_podcast")
}

model Blog {
  id         Int     @id @default(autoincrement())
  uuid       String  @unique @default(uuid())
  creator_id Int
  creator    User    @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  content_id Int     @unique
  content    Content @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("blog")
}

model Ebook {
  id              Int            @id @default(autoincrement())
  uuid            String         @unique @default(uuid())
  author          String
  pages           Int
  publication     String
  file_id         Int
  isbn            String
  release_date    DateTime
  content_id      Int            @unique
  content         Content        @relation(fields: [content_id], references: [id], onDelete: Cascade)
  file_attachment FileAttachment @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("ebook")
}

model Story {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  creator_id Int
  creator    student   @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  episode    Episode[]
  content_id Int       @unique
  content    Content   @relation(fields: [content_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("story")
}

model Episode {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  title      String
  content    String
  order      Int       @unique
  story_id   Int
  story      Story     @relation(fields: [story_id], references: [id], onDelete: Cascade)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  comment    Comment[]
  rating     Rating[]

  @@index([uuid])
  @@map("episode")
}

model Prakerin {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(uuid())
  creator_id   Int
  creator      student   @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  pages        Int
  file_id      Int
  published_at DateTime?
  content_id   Int       @unique
  content      Content   @relation(fields: [content_id], references: [id], onDelete: Cascade)

  file_attachment FileAttachment @relation(fields: [file_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("prakerin")
}

model Submission {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @default(uuid())
  student_id     Int
  student        student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  content_id     Int         @unique
  content        Content     @relation(fields: [content_id], references: [id], onDelete: Cascade)
  competition_id Int
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  judge          judge[]
  winner         Winner[]
  score          Score[]

  @@index([uuid])
  @@map("submission")
}

model judge {
  id             Int          @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  user_id        Int          @unique
  user           User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role           String?
  linkedin       String?
  instagram      String?
  competition_id Int?
  competition    Competition? @relation(fields: [competition_id], references: [id])
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  score          Score[]
  submission     Submission?  @relation(fields: [submissions_id], references: [id])
  submissions_id Int?

  @@index([uuid])
  @@map("judge")
}

model EvaluationParameter {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @default(uuid())
  competition_id Int
  parameter_name String
  weight         Float       @default(1)
  created_at     DateTime    @default(now())
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  scores         Score[]

  @@index([uuid])
  @@map("evaluation_parameter")
}

model Score {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(uuid())
  judge_id      Int
  submission_id Int
  parameter_id  Int
  score         Int
  notes         String? // Catatan opsional dari juri
  created_at    DateTime            @default(now())
  judge         judge               @relation(fields: [judge_id], references: [id])
  submission    Submission          @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  parameter     EvaluationParameter @relation(fields: [parameter_id], references: [id], onDelete: Cascade)

  @@index([uuid])
  @@map("score")
}

model Competition {
  id                   Int                   @id @default(autoincrement())
  uuid                 String                @unique @default(uuid())
  thumbnail            String
  title                String
  slug                 String                @unique
  type                 ContentType
  description          String
  guide                String
  winner_count         Int
  start_date           DateTime
  end_date             DateTime
  submission_deadline  DateTime
  submission           Submission[]
  winner               Winner[]
  judge                judge[]
  evaluation_parameter EvaluationParameter[]

  @@index([uuid])
  @@map("competition")
}

model Winner {
  id             Int         @id @default(autoincrement())
  uuid           String      @unique @default(uuid())
  competition_id Int
  competition    Competition @relation(fields: [competition_id], references: [id], onDelete: Cascade)
  submission_id  Int
  submission     Submission  @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  rank           Int

  @@index([uuid])
  @@map("winner")
}

enum SexType {
  male
  female
}

model student {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(uuid())
  nis        String    @unique
  name       String
  major_id   Int
  major      Major     @relation(fields: [major_id], references: [id], onDelete: Restrict)
  birthplace String?
  birthdate  DateTime?
  sex        SexType
  status     Boolean   @default(false)
  user_id    Int       @unique
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  video_podcast VideoPodcast[]
  audio_podcast AudioPodcast[]
  story         Story[]
  prakerin      Prakerin[]
  submission    Submission[]

  @@index([uuid])
  @@map("student")
}

model Major {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  name        String    @unique
  image       String?
  description String?
  avatar      String?
  student     student[]

  @@index([uuid])
  @@map("major")
}
